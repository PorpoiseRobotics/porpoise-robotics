# =============================================================================
# .gitignore — files git should pretend do not exist
#
# Anything matching a line below will never be committed, and will not show up
# when you run `git status`. This keeps build junk, editor settings, and
# secrets out of a repository that anyone on the internet can read.
#
# If git is ignoring a file you actually want to commit, you can force it:
#     git add --force path/to/file
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS — the most important section. This repository is public.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials.json
secrets.json
secrets.yaml
secrets.yml
config.local.*
# base_station.py writes this at runtime and it ends up holding the camera's
# IP address and the field's real GPS coordinates. Never commit it.
ground-vehicle/src/find-the-target/BaseStation/config.json
*_secret*
*_secrets*
*.credentials

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing and type checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# C / C++
# -----------------------------------------------------------------------------
*.o
*.obj
*.lo
*.slo
*.a
*.lib
*.la
*.dll
*.dylib
*.exe
*.out
*.app
*.d
*.gch
*.pch
*.su
*.idb
*.pdb

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile.cmake
_deps/
compile_commands.json

# -----------------------------------------------------------------------------
# Arduino / PlatformIO
# -----------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
*.ino.cpp
*.hex
*.elf
*.bin
*.eep
*.map

# -----------------------------------------------------------------------------
# ROS / ROS2 build artifacts
# -----------------------------------------------------------------------------
build/
devel/
install/
log/
logs/
.catkin_tools/
.catkin_workspace
devel_isolated/
build_isolated/
*.bag
*.db3
*.db3-shm
*.db3-wal
*.rosinstall

# -----------------------------------------------------------------------------
# Machine learning artifacts (large files do not belong in git)
# -----------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.pb
*.tflite
*.ckpt
*.weights
checkpoints/
runs/
wandb/

# -----------------------------------------------------------------------------
# Recorded media — never commit camera footage or captured data
# -----------------------------------------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
recordings/
captures/
footage/

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.\#*
\#*\#
*.sublime-project
*.sublime-workspace
.spyderproject
.ropeproject

# -----------------------------------------------------------------------------
# Operating system junk
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
Thumbs.db
Thumbs.db:encryptable
# Word/Excel/PowerPoint lock files, left behind when a document is open
~$*
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.fuse_hidden*
.nfs*

# -----------------------------------------------------------------------------
# Node (only if a project adds a web dashboard or tooling)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
tmp/
temp/
